{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,           /* Crucial: Allows JS and TS files to coexist */
    "skipLibCheck": true,
    "strict": false,           /* Keep false initially to limit overwhelming errors */
    "noEmit": true,            /* Let your existing bundler (Vite/Webpack) handle output */
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",         /* For React 17+ JSX transform */
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src", 
    "react-app-env.d.ts" // Ensure your file or its directory is included
  ]
}
